# prometheus-mcp configuration
#
# `PROMETHEUS_MCP_SERVERS` is a comma-separated list of short slugs
# naming the Prometheus servers this MCP server can query. Slugs may
# contain a-z, 0-9, `_`, and `-`. Each slug needs a `_URL`; any number
# of `_HEADER_<NAME>` variables become request headers (header names
# SCREAMING_SNAKE_CASE → Header-Case on the wire).

PROMETHEUS_MCP_SERVERS=prod,stg,dev

PROMETHEUS_MCP_PROD_URL=https://prom-prod.example/
# PROMETHEUS_MCP_PROD_HEADER_AUTHORIZATION=Bearer your-token-here
# PROMETHEUS_MCP_PROD_HEADER_X_SCOPE_ORGID=tenant-7

PROMETHEUS_MCP_STG_URL=https://prom-stg.example/

PROMETHEUS_MCP_DEV_URL=http://localhost:9090/
